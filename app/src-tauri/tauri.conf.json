{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoseWear",
  "version": "0.1.0",
  "identifier": "com.cnsunsz.posewear",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "衣姿 PoseWear",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "PoseWear",
    "shortDescription": "姿势、服装、人像参考图库与 AI 试穿",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
